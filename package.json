{
  "name": "streamock",
  "version": "3.0.2",
  "description": "A simple data streaming mock server",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "streamock": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/run-server.ts",
    "build": "bun build ./src/cli.ts --outfile=dist/cli.js --target=node",
    "start": "bun run dist/run-server.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "streaming",
    "mock",
    "server"
  ],
  "author": "wangym",
  "license": "MIT",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "commander": "^11.1.0",
    "inversify": "^6.2.2",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qs": "^6.9.18",
    "bun-types": "latest",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wangggym/streamock"
  },
  "bugs": {
    "url": "https://github.com/Wangggym/streamock/issues"
  },
  "homepage": "https://github.com/Wangggym/streamock#readme"
}
