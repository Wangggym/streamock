{
  "name": "streamock",
  "version": "3.1.1",
  "description": "A simple data streaming mock server",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "streamock": "./dist/cli.js"
  },
  "scripts": {
    "dev:server": "bun run src/devServer.ts",
    "dev:frontend": "vite",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:frontend\"",
    "build:server": "bun build ./src/cli.ts --outfile=dist/cli.js --target=node",
    "build:frontend": "vite build",
    "build": "bun run build:server && bun run build:frontend",
    "start": "bun run dist/devServer.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "streaming",
    "mock",
    "server"
  ],
  "author": "wangym",
  "license": "MIT",
  "dependencies": {
    "buffer": "^6.0.3",
    "class-transformer": "^0.5.1",
    "commander": "^11.1.0",
    "inversify": "^6.2.2",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qs": "^6.9.18",
    "bun-types": "latest",
    "concurrently": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wangggym/streamock"
  },
  "bugs": {
    "url": "https://github.com/Wangggym/streamock/issues"
  },
  "homepage": "https://github.com/Wangggym/streamock#readme"
}
